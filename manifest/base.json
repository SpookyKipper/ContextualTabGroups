{
  "manifest_version": 3,
  "version": "1.7.3",
  "default_locale": "en",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/tab_islands.png"
  },
  "author": "Spooky Kipper",
  "homepage_url": "https://spooky.hk/",
  "icons": {
    "32": "icons/tab_islands32.png",
    "64": "icons/tab_islands64.png",
    "128": "icons/tab_islands128.png"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "webNavigation"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "newTabInGroup": {
      "description": "__MSG_cmdNewTabInGroup__",
      "suggested_key": {
        "default": "Alt+T"
      }
    }
  }
}
